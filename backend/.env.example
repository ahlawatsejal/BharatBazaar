# BharatBazaar Backend Environment Configuration (Example)
# Copy this file to .env and fill in real values. Never commit .env to Git.

# Django Core
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-strong-random-secret-key-at-least-32-chars
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# MySQL 8.0 Database
DB_NAME=bharatbazaar_db
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=localhost
DB_PORT=3306

# Razorpay Payment Gateway (Test Mode)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=your_razorpay_test_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
